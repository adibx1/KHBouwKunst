# SMTP delivery for the quote form (src/lib/mail.ts).
# Copy to .env.local for local development and set the same keys in Vercel
# under Settings > Environment Variables. Never commit real credentials.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@khbouwkunst.nl
SMTP_PASS=

# Optional. Defaults to true when SMTP_PORT is 465, otherwise false + STARTTLS.
# SMTP_SECURE=false

# Optional. Sender shown on the notification mail. Must be an address the SMTP
# account is allowed to send as. Defaults to "KH Bouw Kunst <SMTP_USER>".
# MAIL_FROM="KH Bouw Kunst <info@khbouwkunst.nl>"

# Optional. Inbox that receives the requests. Defaults to site.email.
# MAIL_TO=info@khbouwkunst.nl
